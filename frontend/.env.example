
NEXT_PUBLIC_HORIZON_URL=https://horizon.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL=https://rpc.ankr.com/stellar_soroban
NEXT_PUBLIC_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015

NEXT_PUBLIC_TESTNET_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_TESTNET_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_TESTNET_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Token deployment
# Address (contract ID) of the deployed factory contract. Used to deploy+initialize
# tokens in a single atomic transaction (see #368).
NEXT_PUBLIC_FACTORY_ADDRESS=
# WASM hash of the token contract. Only required when NEXT_PUBLIC_USE_LEGACY_DEPLOY=true.
NEXT_PUBLIC_TOKEN_WASM_HASH=
# Set to "true" to use the legacy two-transaction deploy (createContract, then initialize)
# instead of the atomic factory deploy.
NEXT_PUBLIC_USE_LEGACY_DEPLOY=false